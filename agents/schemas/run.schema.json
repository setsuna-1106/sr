{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sr:agent-run:0.1.0",
  "title": "sr Agent Run v0.1",
  "type": "object",
  "required": ["schema_version", "project", "run_id", "question", "created_at", "status", "roles", "inputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "project": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "running", "completed", "blocked"]},
    "roles": {"type": "array", "minItems": 5},
    "inputs": {"type": "object"}
  }
}
